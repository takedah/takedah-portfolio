<mxfile host="app.diagrams.net">
  <diagram id="architecture" name="Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="650" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 枠 -->
        <mxCell id="aws-cloud" value="AWS Cloud" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;points=[];outlineConnect=0;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;fontSize=12;dashed=0;html=0;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="890" height="450" as="geometry" />
        </mxCell>
        <mxCell id="region-us-east-1" value="us-east-1" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;points=[];outlineConnect=0;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;fontSize=12;dashed=1;html=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="200" height="150" as="geometry" />
        </mxCell>
        <mxCell id="region-tokyo" value="ap-northeast-1（東京）" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;points=[];outlineConnect=0;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#147EBA;fontSize=12;dashed=1;html=0;" vertex="1" parent="1">
          <mxGeometry x="840" y="60" width="210" height="300" as="geometry" />
