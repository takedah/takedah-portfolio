        <mxCell id="headers" value="レスポンスヘッダーポリシー&#xa;CSP、HSTS など" style="rounded=1;arcSize=10;fillColor=#F2F2F2;strokeColor=#8C4FFF;fontColor=#232F3E;fontSize=12;html=0;" vertex="1" parent="1">
