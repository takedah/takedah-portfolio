          <mxGeometry x="50" y="200" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="route53" value="Route 53&#xa;A・AAAA エイリアス" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.route_53;outlineConnect=0;fillColor=#8C4FFF;strokeColor=#FFFFFF;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontColor=#232F3E;fontSize=12;aspect=fixed;dashed=0;html=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="80" width="64" height="64" as="geometry" />
